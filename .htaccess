# .htaccess racine (htdocs/) pour InfinityFree.
# La racine web ne peut pas être changée : elle reste htdocs/. On route donc
# tout le trafic vers public/, le vrai point d'entrée de l'application. Les
# chemins relatifs de public/index.php (../vendor, ../app) restent valides
# puisque public/ est un sous-dossier de htdocs/.

DirectoryIndex index.php index.html

RewriteEngine On

# Requête déjà dans public/ : ne rien faire (garde-fou anti-boucle).
RewriteRule ^public/ - [L]

# Tout le reste : préfixer public/ puis laisser public/.htaccess router.
RewriteRule ^(.*)$ public/$1 [L]
