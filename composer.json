{
    "name": "toile/toile",
    "description": "Toile - Le marketplace des artistes",
    "type": "project",
    "require": {
        "php": "^8.1",
        "altorouter/altorouter": "^2.0",
        "vlucas/phpdotenv": "^5.6",
        "stripe/stripe-php": "^20.3",
        "phpmailer/phpmailer": "^7.1",
        "dompdf/dompdf": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
